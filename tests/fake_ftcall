#!/usr/bin/env python3
"""Stand-in for ftcall/ftcall in tests (docs/DESIGN_FACETIME_CALL.md section 11).

With FAKE_FTCALL_DIR unset: `state` is always none. With it set, that directory holds:
  states        one state per line ("<state>" or "<state>|<text>", or FAIL to make that
                read exit 3); each `state` call consumes the first line, and the
                last line repeats forever
  devices.json  what `devices` prints (exit 3 if missing)
  presses.log   every `press <button>` is appended here
  press_fail    if present, `press` exits 3 (the banner vanished under the click)
  fail          if present, every command exits 3 with its content on stderr
"""
import json, os, sys

d = os.environ.get("FAKE_FTCALL_DIR")
cmd = sys.argv[1:]
if d and os.path.exists(os.path.join(d, "fail")):
    sys.stderr.write(open(os.path.join(d, "fail")).read())
    sys.exit(3)
if cmd == ["state"]:
    line = "none"
    if d:
        path = os.path.join(d, "states")
        lines = [l for l in open(path).read().splitlines() if l]
        line = lines[0]
        if len(lines) > 1:
            open(path, "w").write("\n".join(lines[1:]) + "\n")
    if line == "FAIL":
        sys.stderr.write("AX read stalled\n")
        sys.exit(3)
    state, _, text = line.partition("|")
    print(json.dumps({"state": state, "text": text}))
elif len(cmd) == 2 and cmd[0] == "press":
    if d and os.path.exists(os.path.join(d, "press_fail")):
        sys.stderr.write("no FaceTime call banner to press %s on\n" % cmd[1])
        sys.exit(3)
    if d:
        with open(os.path.join(d, "presses.log"), "a") as f:
            f.write(cmd[1] + "\n")
elif cmd == ["devices"]:
    path = os.path.join(d or "/nonexistent", "devices.json")
    if not os.path.exists(path):
        sys.stderr.write("FaceTime is not running\n")
        sys.exit(3)
    print(open(path).read().strip())
else:
    sys.stderr.write("usage\n")
    sys.exit(3)
